{
  "name": "node-fundamentals-http-server",
  "version": "1.0.0",
  "description": "A zero-dependency Notes API and static file server built only on Node.js core modules: http, fs, streams, events, path and url.",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed": "node scripts/seed.js",
    "demo:event-loop": "node scripts/event-loop-demo.js",
    "clean": "node scripts/clean.js"
  },
  "keywords": [
    "nodejs",
    "http",
    "fs",
    "streams",
    "events",
    "event-loop",
    "commonjs",
    "no-dependencies"
  ],
  "author": "Memona",
  "license": "MIT"
}
